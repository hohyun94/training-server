# PostgreSQL 연결 문자열 (필수)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# 서버 포트 (PaaS 는 보통 PORT 를 주입합니다)
PORT=8080

# 강사 콘솔 비밀번호 (필수, 배포 시 반드시 변경)
ADMIN_PASSWORD=change-me

# 세션 쿠키 서명 키 (필수, 32자 이상 권장)
JWT_SECRET=change-me-to-a-long-random-string

# HTTPS 로 서비스할 때 true
COOKIE_SECURE=false

# 메인화면 QR 에 찍힐 공개 주소 (예: https://training.example.com)
# 비워두면 접속한 요청의 Host 를 사용합니다.
PUBLIC_BASE_URL=

# 업로드 파일 저장 경로 (PaaS 무료 플랜은 휘발성일 수 있음)
UPLOAD_DIR=data/uploads

# 서버 시작 시 마이그레이션 자동 실행 여부 (기본 true)
RUN_MIGRATIONS=true
