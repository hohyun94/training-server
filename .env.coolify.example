# Coolify 자동 배포 설정
# 사용: Copy-Item .env.coolify.example .env.coolify  후 값 입력 (git 에 커밋되지 않음)

# Coolify 인스턴스 주소 (끝에 / 없이)
COOLIFY_URL=https://coolify.example.com

# Coolify → Keys & Tokens → API tokens 에서 발급 (write 권한)
COOLIFY_TOKEN=

# 강사 콘솔(/admin) 로그인 비밀번호
ADMIN_PASSWORD=

# 세션 쿠키 서명 키 (32자 이상, 비우면 자동 생성 후 로그에 출력)
JWT_SECRET=

# 배포 도메인 (Coolify DNS/TLS 로 연결). 비우면 Coolify 자동 도메인 사용
APP_DOMAIN=https://training.example.com

# 대상 (기본값)
COOLIFY_PROJECT=AX Training
COOLIFY_ENVIRONMENT=production
# COOLIFY_SERVER=localhost
# COOLIFY_GITHUB_APP=
APP_NAME=training-server
DB_NAME=training-db
